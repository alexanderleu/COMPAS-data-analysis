import pandas as pd

# === Step 1: Load dataset ===
df = pd.read_csv(r"C:\Users\Schule\Downloads\compas-scores-two-years.csv")

# === Step 2: Filter for Black and White defendants ===
df = df[df['race'].isin(['African-American', 'Caucasian'])]

# === Step 3: Clean and standardize category labels ===
# Ensure all score_text values are valid (some rows may have missing)
df = df[df['score_text'].isin(['Low', 'Medium', 'High'])]

# === Step 4: Group and count ===
summary = (
    df.groupby(['race', 'score_text', 'two_year_recid'])
      .size()
      .reset_index(name='count')
)

# Add readable labels for reoffending status
summary['reoffended_label'] = summary['two_year_recid'].map({1: 'Reoffended', 0: 'Did not reoffend'})

# === Step 5: Pivot to make each outcome its own column ===
pivot = (
    summary.pivot_table(
        index=['race', 'score_text'],
        columns='reoffended_label',
        values='count',
        fill_value=0
    )
    .reset_index()
)

# === Step 6: Add percentage columns (optional but very useful) ===
pivot['Total'] = pivot['Did not reoffend'] + pivot['Reoffended']
pivot['% Reoffended'] = (pivot['Reoffended'] / pivot['Total'] * 100).round(2)
pivot['% Did not reoffend'] = (pivot['Did not reoffend'] / pivot['Total'] * 100).round(2)

# === Step 7: Display results ===
print(pivot)

# === Step 8: Export to CSV for your visualization ===
pivot.to_csv("compas_risk_summary_detailed.csv", index=False)
print("\nData saved to compas_risk_summary_detailed.csv")
